{
  "name": "@botiverse/porthole",
  "version": "0.14.3",
  "description": "A host-side sandbox for agent-made HTML: isolation, egress hardening, a themed shell, gated host functions, and the agent manual, from one config.",
  "homepage": "https://github.com/botiverse/porthole#readme",
  "bugs": {
    "url": "https://github.com/botiverse/porthole/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/botiverse/porthole.git",
    "directory": "packages/porthole"
  },
  "bin": {
    "porthole": "./src/cli.ts"
  },
  "files": [
    "src",
    "dist",
    "types/runtime/**/*.d.ts",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts",
    "./mcp": "./src/mcp/index.ts",
    "./conformance": "./src/conformance/index.ts",
    "./server": "./src/server/index.ts",
    "./node": "./src/node/index.ts",
    "./check": "./src/check/index.ts",
    "./check/page": "./src/check/page-source.ts",
    "./conformance/reporter": "./src/conformance/reporter.ts"
  },
  "publishConfig": {
    "bin": {
      "porthole": "./dist/cli.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "./mcp": {
        "types": "./dist/mcp/index.d.ts",
        "default": "./dist/mcp/index.js"
      },
      "./conformance": {
        "types": "./dist/conformance/index.d.ts",
        "default": "./dist/conformance/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "./node": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "./check": {
        "types": "./dist/check/index.d.ts",
        "default": "./dist/check/index.js"
      },
      "./check/page": {
        "types": "./dist/check/page-source.d.ts",
        "default": "./dist/check/page-source.js"
      },
      "./conformance/reporter": {
        "types": "./dist/conformance/reporter.d.ts",
        "default": "./dist/conformance/reporter.js"
      }
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node scripts/build-harness.ts && node scripts/copy-docs.ts",
    "test:leak": "playwright test -c leak/playwright.config.ts",
    "test:controls": "node scripts/controls.ts",
    "test:bundle": "node scripts/bundle-test.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/server-basic-react": "2.0.4",
    "@modelcontextprotocol/server-basic-vanillajs": "2.0.4",
    "@modelcontextprotocol/server-threejs": "2.0.4",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chart.js": "4.5.1",
    "d3": "7.9.0",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rolldown": "1.2.11",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
